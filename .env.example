# Postgres (Neon / Supabase / local). Include sslmode=require for hosted DBs.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Claude — used for RAG answers and NL-to-SQL generation (not embeddings).
ANTHROPIC_API_KEY=

# OpenAI — used only for embeddings (text-embedding-3-small, 1536 dims).
# Anthropic does not expose an embedding API; the schema's VECTOR(1536) matches this model.
OPENAI_API_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# EMBEDDING_MODEL=text-embedding-3-small
