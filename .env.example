# Postgres (Neon / Supabase / local). Include sslmode=require for hosted DBs.
#
# This must be a role WITHOUT the BYPASSRLS attribute, or per-user data
# isolation silently does nothing (see backend/db.py's get_user_conn).
# Neon's and Supabase's default "owner" role has BYPASSRLS by default —
# don't point this at it. Create a dedicated one instead:
#
#   CREATE ROLE within_app WITH LOGIN PASSWORD '...' NOBYPASSRLS;
#   GRANT USAGE ON SCHEMA public TO within_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO within_app;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO within_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO within_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO within_app;
#
# (run once, connected as the owner role — the same connection string you'd
# put in DATABASE_MIGRATION_URL below)
DATABASE_URL=postgresql://within_app:PASSWORD@HOST/dbname?sslmode=require

# The owner/admin connection — same host and database as above, different
# role. Only used to apply backend/schema.sql on boot (CREATE TABLE, ALTER
# TABLE, CREATE POLICY need DDL rights the runtime role above intentionally
# doesn't have). Omit this to run both migrations and queries as one role —
# fine for a fresh local Postgres install where you control every role's
# attributes, but confirm that role doesn't have BYPASSRLS either.
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Groq — free API, no card required (console.groq.com). Used for RAG answers
# and NL-to-SQL generation (not embeddings).
GROQ_API_KEY=

# Signs session tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Rotating it logs everyone out; never commit the real value.
JWT_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Optional overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# EMBEDDING_MODEL=all-MiniLM-L6-v2
